{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WMO",
  "version": "0.1.0",
  "identifier": "com.wmo.overlay",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WMO",
        "label": "main",
        "width": 480,
        "height": 188,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
